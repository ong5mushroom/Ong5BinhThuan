<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Nấm Ông 5 - Quản Trị Hệ Thống</title>
    <!-- Google Fonts cho màu sắc tươi vui, dễ đọc -->
    <link href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;600;700&display=swap" rel="stylesheet">
    <!-- Bootstrap CSS để dựng layout nhanh -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="css/style.css">
</head>
<body>
    <!-- Navbar cơ bản -->
    <nav class="navbar navbar-expand-lg custom-navbar">
        <div class="container-fluid">
            <a class="navbar-brand text-white fw-bold" href="index.html">🍄 Nấm Ông 5</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav me-auto">
                    <li class="nav-item"><a class="nav-link active text-white" href="index.html">Trang chủ</a></li>
                    <li class="nav-item"><a class="nav-link text-white" href="kho.html">Kho</a></li>
                    <li class="nav-item"><a class="nav-link text-white" href="sanxuat.html">Sản xuất</a></li>
                    <li class="nav-item"><a class="nav-link text-white" href="giong.html">Giống</a></li>
                    <li class="nav-item"><a class="nav-link text-white" href="dotlo.html">Đốt lò</a></li>
                </ul>
                <div class="d-flex align-items-center">
                    <span class="text-white me-3" id="userGreeting">Đang tải...</span>
                    <button class="btn btn-light btn-sm" id="btnLogout">Đăng xuất</button>
                </div>
            </div>
        </div>
    </nav>

    <div class="container mt-4">
        <!-- Lời chào ngày mới & Thông báo -->
        <div class="row mb-4">
            <div class="col-12">
                <div class="alert custom-alert d-flex align-items-center" role="alert">
                    <div>
                        <h4 class="alert-heading fw-bold" id="dailyGreeting">Chào ngày mới năng lượng! 🌞</h4>
                        <p class="mb-0">Thông báo mới: Chuẩn bị xuống giống đợt Nấm Hương và Nấm Hầu Thủ mới trong tuần này. Chúc mọi người một ngày làm việc hiệu quả!</p>
                    </div>
                </div>
            </div>
        </div>

        <!-- Chấm công / Điểm danh -->
        <div class="row mb-4">
            <div class="col-md-6 offset-md-3 text-center">
                <div class="card shadow-sm rounded-4 border-0 p-4 checkin-card">
                    <h5 class="fw-bold mb-3">Điểm danh nhận việc</h5>
                    <p id="currentTime" class="h3 fw-bold text-primary mb-3">00:00:00</p>
                    <button id="btnCheckIn" class="btn btn-success btn-lg rounded-pill px-5 shadow">📍 Nhận ca làm việc</button>
                    <p id="checkInStatus" class="mt-3 text-muted small"></p>
                </div>
            </div>
        </div>
    </div>

    <!-- Firebase SDK (Modular) -->
    <script type="module" src="js/firebase-config.js"></script>
    <script type="module" src="js/main.js"></script>
    <script>
        // Cập nhật đồng hồ điểm danh
        setInterval(() => {
            const now = new Date();
            document.getElementById('currentTime').innerText = now.toLocaleTimeString('vi-VN');
        }, 1000);
    </script>
</body>
</html>
